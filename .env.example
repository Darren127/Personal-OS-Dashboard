# Personal OS — environment variables
# Copy this file to `.env.local` and fill in real values there.
# `.env.local` is git-ignored. NEVER put real keys in this file.

# --- Supabase (database) ---------------------------------------------------
# Supabase dashboard → Project Settings → API Keys.
# The URL and publishable key are designed to be public; Row Level Security
# protects the data. Variables starting with NEXT_PUBLIC_ are visible in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Secret key bypasses Row Level Security. Server-only — never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# --- Anthropic (AI Companion) ----------------------------------------------
# Create at https://console.anthropic.com → API Keys. This is pay-as-you-go
# API billing and is NOT included in a Claude Pro subscription.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Optional: model (default claude-opus-5-5) and thinking effort
# (low | medium | high | xhigh | max; default medium). Lower effort = cheaper, faster.
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=

# Optional: soft monthly spending guard in US dollars (e.g. 10).
AI_MONTHLY_BUDGET_USD=

# --- Gmail Intelligence (Google OAuth) ---------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type "Web application"). Step-by-step guide: docs/GMAIL_SETUP.md
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Server-only. Never prefix with NEXT_PUBLIC_.
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# Must be registered exactly in Google Cloud Console and match where the app runs:
#   local:      http://localhost:3000/api/gmail/callback
#   production: https://<your-app>.vercel.app/api/gmail/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
# Encrypts stored Gmail refresh tokens. 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later means reconnecting Gmail.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Optional: sync window in days (default 7), messages kept per sync (default 50),
# new emails analysed by Claude per refresh (default 25; 0 turns analysis off),
# and analysis effort (low | medium | high; default low).
GMAIL_SYNC_DAYS=
GMAIL_SYNC_MAX_MESSAGES=
GMAIL_ANALYZE_MAX=
GMAIL_ANALYSIS_EFFORT=
